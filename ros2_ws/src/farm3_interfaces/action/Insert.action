# /farm3/insert : 적재대의 새 보드를 프린터에 투입
# 순서: 홈 → 적재대[start_pos_id] 집기 → 홈 → 프린터[printer_pos_id] 놓기 → 홈

# ---- goal ----
int32 work_id
int8 start_pos_id        # 적재대 칸 ID (아래층부터 투입하는 순서는 서버가 결정)
int8 printer_pos_id      # 프린터 ID
---
# ---- result ----
uint8 WORK_TYPE_INSERT=0
uint8 WORK_TYPE_EJECT=1
bool success
string message
int32 work_id
uint8 work_type          # 항상 WORK_TYPE_INSERT
---
# ---- feedback ----
builtin_interfaces/Time start_at
builtin_interfaces/Time end_at   # 진행 중에는 0, 마지막 feedback 에서 채워짐
int32 work_id
uint32 step              # 현재 단계 (1부터)
uint32 total             # 전체 단계 수
string phase             # 현재 단계 설명
